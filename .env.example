# Copy to .env. Everything is optional; defaults shown.

TZ=Asia/Kolkata
DIGEST_TIME=08:30          # daily run time (HH:MM in TZ) for `serve`
RUN_ON_START=0             # 1 = also run immediately when the container starts

# Selection
MNC_DAYS=3                 # MNC postings no older than this
STARTUP_DAYS=10            # startups post fresher roles rarely, so a wider window
MNC_COUNT=10
STARTUP_MIN=10             # below this the run is flagged "short" in `stats`
STARTUP_MAX=15
INCLUDE_INTERNS=0
VERIFY_LINKS=1             # HEAD/GET every apply URL before publishing

# Sources
ENABLE_ATS=1               # ~150 employer career portals (Workday/Greenhouse/Ashby/Lever/Workable/SmartRecruiters)
ENABLE_TALENTD=1
ENABLE_LINKEDIN=1
ENABLE_UNSTOP=1
ENABLE_INTERNSHALA=1
ADZUNA_APP_ID=              # optional aggregator; free key at developer.adzuna.com
ADZUNA_APP_KEY=

# Control panel / public app
ADMIN_TOKEN=                # when set, Scrape and Hide require this token (keep set on any public deployment)

# Delivery (leave blank to skip). Digest is split into chunks that fit each platform's limit.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=       # receives {"date","mnc":[...],"startups":[...]} as JSON POST

# Storage (host runs only; Docker sets /data)
# JOBS_DATA_DIR=/path/to/data
